#!/bin/bash
# devos-install — DevOS 2.0 disk installer (real partitioning + copy + GRUB)
# Hinglish: live session se disk pe install karta hai. BIOS + UEFI dono.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive

DISK=""; USERNAME="devos"; PASSWORD=""; NEWHOST="devos"; ASSUME=0
TARGET=/target

die() { echo; echo "ERROR: $*" >&2; exit 1; }
say() { echo; echo "==> $*"; }

for arg in "$@"; do
    case "$arg" in
        --yes) ASSUME=1 ;;
        --disk=*) DISK="${arg#*=}" ;;
        --user=*) USERNAME="${arg#*=}" ;;
        --password=*) PASSWORD="${arg#*=}" ;;
        --hostname=*) NEWHOST="${arg#*=}" ;;
        -h|--help)
            echo "usage: devos-install [--yes] [--disk=/dev/sdX] [--user=NAME] [--password=Pass] [--hostname=NAME]"
            exit 0 ;;
        *) die "unknown option: $arg" ;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "root ke roop me chalao (live session me already root hota hai)"

clear 2>/dev/null || true
cat <<'BANNER'
  DevOS 2.0 "Whale" — Installer
  -----------------------------
  Ye live system ko disk par install karega:
    • partition (UEFI: ESP+root, BIOS: single root)
    • ext4 format + poora system copy
    • GRUB bootloader + initramfs
    • naya user + sudo + NetworkManager

  WARNING: chuni hui disk ka poora data MIT jayega.
BANNER

# live medium ko target banane se roko
LIVE_SRC="$(blkid -L DEVOS 2>/dev/null || true)"
LIVE_PARENT=""
if [ -n "$LIVE_SRC" ]; then
    LIVE_PARENT="$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null | head -1 || true)"
fi

if [ -z "$DISK" ]; then
    say "Available disks"
    lsblk -dno NAME,SIZE,TYPE,MODEL | awk '$3=="disk" {printf "  /dev/%-10s %8s  %s\n", $1, $2, substr($0, index($0,$4))}'
    echo
    read -r -p "Target disk (e.g. /dev/sda): " DISK
fi
[ -b "$DISK" ] || die "$DISK block device nahi hai"
if [ -n "$LIVE_SRC" ] && [ "$(basename "$DISK")" = "$(basename "$LIVE_SRC")" ]; then
    die "ye live medium hai — ise install target mat banao"
fi
if [ -n "$LIVE_PARENT" ] && [ "$(basename "$DISK")" = "$LIVE_PARENT" ]; then
    die "ye live USB/CD ki disk hai — doosri disk chuno"
fi

if [ -z "$PASSWORD" ]; then
    [ "$ASSUME" -eq 1 ] && PASSWORD=devos
fi
if [ "$ASSUME" -eq 0 ]; then
    read -r -p "Hostname [$NEWHOST]: " a; [ -n "$a" ] && NEWHOST="$a"
    read -r -p "Username [$USERNAME]: " a; [ -n "$a" ] && USERNAME="$a"
    while [ -z "$PASSWORD" ]; do
        read -r -s -p "Password for $USERNAME: " p1; echo
        read -r -s -p "Repeat password: " p2; echo
        [ "$p1" = "$p2" ] && PASSWORD="$p1" || echo "passwords match nahi kiye"
    done
    echo
    echo "Target : $DISK"
    echo "Host   : $NEWHOST"
    echo "User   : $USERNAME"
    read -r -p "Type WIPE to confirm destructive install: " ans
    [ "$ans" = "WIPE" ] || die "cancelled"
fi

UEFI=0
[ -d /sys/firmware/efi ] && UEFI=1
say "Mode: $([ $UEFI -eq 1 ] && echo UEFI || echo BIOS) · target: $DISK"

# partition naming (nvme/mmc ko p1 chahiye)
case "$DISK" in
    *nvme*|*mmcblk*) P1="${DISK}p1"; P2="${DISK}p2" ;;
    *)               P1="${DISK}1";  P2="${DISK}2" ;;
esac

say "Partitioning $DISK"
wipefs -a "$DISK" >/dev/null 2>&1 || true
if [ "$UEFI" -eq 1 ]; then
    parted -s "$DISK" mklabel gpt
    parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
    parted -s "$DISK" set 1 esp on
    parted -s "$DISK" mkpart root ext4 513MiB 100%
    ROOTDEV="$P2"; ESPDEV="$P1"
else
    parted -s "$DISK" mklabel msdos
    parted -s "$DISK" mkpart primary ext4 1MiB 100%
    parted -s "$DISK" set 1 boot on
    ROOTDEV="$P1"; ESPDEV=""
fi
partprobe "$DISK" 2>/dev/null || true
udevadm settle 2>/dev/null || sleep 1
for i in $(seq 1 20); do [ -b "$ROOTDEV" ] && break; sleep 0.5; done
[ -b "$ROOTDEV" ] || die "partition node $ROOTDEV nahi bana"

say "Formatting"
mkfs.ext4 -F -L DevOS-Root "$ROOTDEV" >/dev/null
if [ "$UEFI" -eq 1 ]; then
    [ -b "$ESPDEV" ] || die "ESP node nahi bana"
    mkfs.vfat -F32 -n DEVOS-ESP "$ESPDEV" >/dev/null
fi

cleanup() {
    umount -R "$TARGET" 2>/dev/null || true
}
trap cleanup EXIT

mkdir -p "$TARGET"
mount "$ROOTDEV" "$TARGET"
if [ "$UEFI" -eq 1 ]; then
    mkdir -p "$TARGET/boot/efi"
    mount "$ESPDEV" "$TARGET/boot/efi"
fi

say "Copying system (rsync) — thoda time lagega"
rsync -aHAX --numeric-ids \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/tmp --exclude=/mnt --exclude=/media --exclude=/target \
    --exclude=/lost+found --exclude=/var/cache/apt/archives \
    --exclude=/root/.cache --exclude=/etc/fstab --exclude=/etc/machine-id \
    / "$TARGET"/
mkdir -p "$TARGET"/{proc,sys,dev,run,tmp,mnt,media}
chmod 1777 "$TARGET/tmp"

ROOT_UUID="$(blkid -s UUID -o value "$ROOTDEV")"
{
    echo "# DevOS 2.0 — generated by devos-install"
    echo "UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1"
    if [ "$UEFI" -eq 1 ]; then
        ESP_UUID="$(blkid -s UUID -o value "$ESPDEV")"
        echo "UUID=$ESP_UUID /boot/efi vfat umask=0077 0 1"
    fi
} > "$TARGET/etc/fstab"

echo "$NEWHOST" > "$TARGET/etc/hostname"
cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1 localhost
127.0.1.1 $NEWHOST
::1 localhost ip6-localhost ip6-loopback
EOF
rm -f "$TARGET/etc/resolv.conf"
systemd-machine-id-setup --root="$TARGET" >/dev/null 2>&1 || true

say "Creating user $USERNAME"
if ! chroot "$TARGET" id "$USERNAME" >/dev/null 2>&1; then
    chroot "$TARGET" useradd -m -s /bin/bash -G sudo "$USERNAME"
fi
echo "$USERNAME:$PASSWORD" | chroot "$TARGET" chpasswd
chroot "$TARGET" passwd -l root >/dev/null 2>&1 || true

# installed system: lock screen se start (autologin nahi), live flag hatao
rm -f "$TARGET/etc/devos-live"
sed -i 's/ --autologin//' "$TARGET/etc/systemd/system/devos-comp.service"

# boot params + timeout
if [ -f "$TARGET/etc/default/grub" ]; then
    sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=1/' "$TARGET/etc/default/grub"
    sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 vt.global_cursor_default=0"/' "$TARGET/etc/default/grub"
fi

say "initramfs + GRUB"
for d in dev proc sys; do mount --bind "/$d" "$TARGET/$d"; done
OUT="$(chroot "$TARGET" update-initramfs -c -k all 2>&1)" || die "update-initramfs fail:
$OUT"
if [ "$UEFI" -eq 1 ]; then
    OUT="$(chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
        --bootloader-id=DevOS --no-nvram 2>&1)" || \
    OUT="$(chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
        --removable 2>&1)" || die "grub-install (UEFI) fail:
$OUT"
    chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
        --removable >/dev/null 2>&1 || true
else
    OUT="$(chroot "$TARGET" grub-install --target=i386-pc --boot-directory=/boot "$DISK" 2>&1)" || \
        die "grub-install (BIOS) fail:
$OUT"
fi
OUT="$(chroot "$TARGET" update-grub 2>&1)" || die "update-grub fail:
$OUT"

for d in sys proc dev; do umount -R "$TARGET/$d" 2>/dev/null || true; done
sync
trap - EXIT
umount -R "$TARGET" 2>/dev/null || true

say "Install complete"
echo "  Disk : $DISK"
echo "  User : $USERNAME"
echo "  Boot : $([ $UEFI -eq 1 ] && echo 'UEFI (GRUB → DevOS)' || echo 'BIOS (GRUB → DevOS)')"
echo
echo "Ab live medium nikaal ke reboot karo — DevOS installed system khulega."
if [ "$ASSUME" -eq 0 ]; then
    read -r -p "Abhi reboot karein? [y/N] " r
    case "$r" in y|Y) systemctl reboot ;; esac
fi
