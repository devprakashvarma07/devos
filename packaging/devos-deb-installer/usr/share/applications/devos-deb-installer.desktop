[Desktop Entry]
Type=Application
Version=1.0
Name=DevOS App Installer
GenericName=Install .deb Package
Comment=Install Debian package (.deb) files with one click
Exec=devos-deb-installer %f
TryExec=devos-deb-installer
Icon=devos-deb-installer
Terminal=false
StartupNotify=true
Categories=System;PackageManager;
Keywords=deb;package;install;apt;
MimeType=application/vnd.debian.binary-package;application/x-deb;
